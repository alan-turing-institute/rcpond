# Per-type config for the 'compute_allocation_request' ticket type.
#
# Must live at $XDG_CONFIG_HOME/rcpond/ticket_types/<ticket-type>.config — the path is
# fixed, which is why this file sits under business_logic/rcpond/ticket_types/ and
# business_logic/ is used as XDG_CONFIG_HOME. See ../../README.md.
#
# Paths are relative to the working directory, so run rcpond from the repository root.

RCPOND_SERVICENOW_QUERY="short_description=Request access to HPC and cloud computing facilities"
RCPOND_RULES_PATH=business_logic/compute_allocation_request/RULES.md
RCPOND_EMAIL_TEMPLATES_DIR=business_logic/compute_allocation_request/email_templates
