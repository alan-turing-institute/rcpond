# Per-type config for a second, illustrative ticket type.
#
# NOT YET RUNNABLE: 'software_request' is not registered in _TICKET_TYPES
# (src/rcpond/servicenow.py), so `--ticket-type software_request` is rejected with
# "Unknown ticket_type". These files exist to show the directory layout for a second
# type; see ../../README.md.
#
# Paths are relative to the working directory, so run rcpond from the repository root.

RCPOND_SERVICENOW_QUERY="short_description=Request software installation"
RCPOND_RULES_PATH=example_config_dir/software_request/RULES.md
RCPOND_EMAIL_TEMPLATES_DIR=example_config_dir/software_request/email_templates
