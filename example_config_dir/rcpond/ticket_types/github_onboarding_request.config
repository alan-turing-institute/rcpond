# Per-type config for a second, illustrative ticket type.
#
# Must live at $XDG_CONFIG_HOME/rcpond/ticket_types/<ticket-type>.config — the path is
# fixed, which is why this file sits under example_config_dir/rcpond/ticket_types/ and
# example_config_dir/ is used as XDG_CONFIG_HOME. See ../../README.md.
#
# Paths are relative to the working directory, so run rcpond from the repository root.

RCPOND_SERVICENOW_QUERY="short_description=Requesting Membership of Turing GitHub organisation"
RCPOND_RULES_PATH=example_config_dir/github_onboarding_request/RULES.md
RCPOND_EMAIL_TEMPLATES_DIR=example_config_dir/github_onboarding_request/email_templates
